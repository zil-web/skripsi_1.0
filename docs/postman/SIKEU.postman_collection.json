  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET Login Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var match = pm.response.text().match(/name=\"_token\" value=\"([^\"]+)\"/);",
                  "pm.test('csrf token ditemukan', function () {",
                  "  pm.expect(match, 'csrf token hidden input').to.not.be.null;",
                  "});",
                  "if (match) {",
                    "  pm.environment.set('csrf_token', match[1]);",
                    "  pm.collectionVariables.set('csrf_token', match[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html" },
              { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{admin_username}}", "type": "text" },
                { "key": "password", "value": "{{admin_password}}", "type": "text" },
                { "key": "remember", "value": "on", "type": "text" }
              ]
            },
            "url": {
              "raw": "http://{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "protocolProfileBehavior": {
              "followRedirects": false
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login admin merespons', function () {",
                  "  pm.expect([200, 302]).to.include(pm.response.code);",
                  "});",
                  "var location = pm.response.headers.get('Location') || '';",
                  "if (pm.response.code === 302) {",
                  "  pm.test('redirect ke dashboard admin', function () {",
                  "    pm.expect(location).to.include('/admin/dashboard');",
                  "  });",
                  "}",
                  "// Refresh CSRF token from cookie after login (session may have been regenerated)",
                  "(function(){",
                  "  try {",
                  "    var cookieToken = pm.cookies.get('XSRF-TOKEN') || '';",
                  "    if (cookieToken) {",
                  "      var decoded = decodeURIComponent(cookieToken);",
                  "      pm.environment.set('csrf_token', decoded);",
                  "      pm.collectionVariables.set('csrf_token', decoded);",
                  "      pm.test('csrf token refreshed from cookie', function() { pm.expect(decoded).to.not.equal(''); });",
                  "    }",
                    "    // fallback: try to extract from body if present",
                    "    var m = pm.response.text().match(/name=\"_token\" value=\"([^\"]+)\"/);",
                    "    if (m) { pm.environment.set('csrf_token', m[1]); pm.collectionVariables.set('csrf_token', m[1]); }",
                          "  } catch (e) { pm.environment.unset('csrf_token'); }",
                  "})();"
                ]
              }
            }
          ]
        },
